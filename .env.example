# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=

# Google Calendar OAuth
# Create a Web application OAuth client in Google Cloud.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/admin/google-calendar/callback

# Email address of the therapist/doctor who owns the connected primary Google Calendar.
# Google Calendar uses this address as a required guest so create/update/cancellation notifications reach both participants.
GOOGLE_CALENDAR_THERAPIST_EMAIL=

# Used only to sign the short-lived Google OAuth state cookie.
# Use a long random value and keep it stable after deployment.
GOOGLE_CALENDAR_OAUTH_STATE_SECRET=

# Used to encrypt the Google OAuth refresh token before MongoDB storage.
# Use a long random value; it must remain stable after deployment.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Private therapist/admin authentication
# The username and password hash are used to authenticate the therapist/admin for the Google Calendar connection.
# The session secret is used to sign the session cookie for the therapist/admin.
GRACE_ADMIN_USERNAME=
# Generate locally with: npm run admin:hash-password
GRACE_ADMIN_PASSWORD_HASH=
# Use a long random value (at least 32 characters) and keep it stable after deployment.
GRACE_ADMIN_SESSION_SECRET=
